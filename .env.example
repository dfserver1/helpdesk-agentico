# ============================================================
# HelpDesk Enterprise Copilot - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# --- Azure OpenAI API ---
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DIMENSIONS=3072

# --- Alternative: Google Gemini API ---
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# --- LLM Provider Selection ---
LLM_PROVIDER=azure_openai  # options: azure_openai, google_gemini

# --- JWT Authentication ---
JWT_SECRET_KEY=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Entra ID (Azure AD) ---
ENTRA_ID_TENANT_ID=your_tenant_id
ENTRA_ID_CLIENT_ID=your_client_id
ENTRA_ID_CLIENT_SECRET=your_client_secret
ENTRA_ID_AUTHORITY=https://login.microsoftonline.com/your_tenant_id
ENTRA_ID_SCOPE=https://graph.microsoft.com/.default

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/helpdesk_copilot
# For local dev: DATABASE_URL=sqlite+aiosqlite:///./helpdesk.db

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./data/chroma_store
CHROMA_COLLECTION_NAME=helpdesk_docs
CHROMA_DISTANCE_FUNCTION=cosine

# --- FAISS (Alternative Vector Store) ---
FAISS_INDEX_PATH=./data/faiss_index

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=["http://localhost:8501","http://localhost:3000","http://localhost:8080"]

# --- File Upload ---
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,txt,md

# --- RAG Settings ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=10
RERANK_TOP_K=3
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENSEMBLE_BM25_WEIGHT=0.4
ENSEMBLE_VECTOR_WEIGHT=0.6
SIMILARITY_THRESHOLD=0.25

# --- SLA Settings ---
SLA_P1_RESPONSE_MINUTES=0
SLA_P2_RESPONSE_HOURS=4
SLA_P3_RESPONSE_HOURS=24
SLA_P4_RESPONSE_HOURS=72
SLA_ESCALATION_MULTIPLIER=2
SLA_BUSINESS_HOURS_START=9
SLA_BUSINESS_HOURS_END=18
SLA_TIMEZONE=UTC

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# --- Concurrency (multithreaded sessions + parallel sub-agents) ---
MAX_CONCURRENT_SESSIONS=8
CHAT_EXECUTOR_THREADS=8
SUBTASK_MAX_WORKERS=4
SUBTASK_ENABLED=true

# --- O365 Connectors (Microsoft Graph, app-only via Entra ID) ---
CONNECTORS_ENABLED=false
GRAPH_TENANT_ID=your_entra_tenant_id
GRAPH_CLIENT_ID=your_app_client_id
GRAPH_CLIENT_SECRET=your_app_client_secret
SHAREPOINT_ENABLED=true
TEAMS_ENABLED=true
OUTLOOK_ENABLED=true
CONNECTOR_MAX_RESULTS=8

# --- Web Search fallback (used when KB + connectors miss) ---
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=12
TAVILY_API_KEY=
BRAVE_SEARCH_KEY=

# --- Ticket Backend (ITSM integration) ---
# database (default, persists to the app DB) | freshservice | jira
TICKET_BACKEND=database
# Freshservice (requires TICKET_BACKEND=freshservice)
FRESHSERVICE_BASE_URL=https://your-domain.freshservice.com
FRESHSERVICE_API_KEY=your_api_key
FRESHSERVICE_API_KEY_ID=your_api_key_id
# Jira (requires TICKET_BACKEND=jira) - use an API token (JWT/cloud) or password
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_api_token
JIRA_PROJECT_KEY=HELPDESK

# --- OAuth SSO (Login with Google / Microsoft / GitHub) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/microsoft/callback
OAUTH_SESSION_TTL_HOURS=12

# --- Admin (used by scripts/seed.py to create the initial super-admin) ---
ADMIN_EMAIL=admin@helpdesk.ai
# REQUIRED for production. Use a strong password; never leave empty.
ADMIN_PASSWORD=change_me_to_a_long_unique_password

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
LOG_FORMAT=json

# --- LangSmith Tracing ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=helpdesk-copilot

# --- Langfuse (Alternative) ---
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Memory / Self-Training ---
MEMORY_STORE_TYPE=postgresql  # options: postgresql, sqlite, redis
MEMORY_MAX_HISTORY=50
MEMORY_EMBEDDING_DIMENSIONS=3072
SELF_TRAINING_ENABLED=true
SELF_TRAINING_BATCH_SIZE=100
SELF_TRAINING_MIN_CONFIDENCE=0.8

# --- App ---
APP_NAME=HelpDesk Enterprise Copilot
APP_VERSION=12.0.0
DEBUG=false
ENVIRONMENT=development  # options: development, staging, production

# --- Docker Compose only ---
# POSTGRES_PASSWORD=change_me_db_password
# API_PORT=8000